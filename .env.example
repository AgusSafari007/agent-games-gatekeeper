# Copy to .env locally (never commit a filled .env), or set these in your
# host's dashboard (Railway → Variables). The HMAC secret is issued by the
# Agent Games dashboard (Rotate Secret, shown once) — paste it there
# directly; it should never pass through chat or git.

# Platform-issued HMAC secret for x-agent-games-signature (REQUIRED live)
AGENT_GAMES_HMAC_SECRET=

# Mainnet Kurier API key (optional; without it, proofs are returned in-band
# and no on-chain submission is attempted)
KURIER_API_KEY=

# HTTP port (Railway sets this automatically)
PORT=3000

# Registered handler path — must match the endpoint URL on the dashboard
AGENT_PATH=/agent

# Optional overrides (defaults shown in src/config.js)
# SEEN_TX_PATH=./data/seen_proof_tx.txt
# TIMESTAMP_TOLERANCE_SECONDS=300
# HMAC_ALGORITHM=sha256
# HMAC_ENCODING=hex
